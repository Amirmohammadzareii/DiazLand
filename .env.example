# نمونه متغیرهای محیطی — مقادیر واقعی را هرگز کامیت نکنید
# این فایل را به .env کپی کنید و مقادیر را پر کنید.

# کلید امضای session (اجباری) — یک رشته تصادفی طولانی بسازید
# مثال تولید: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# نام کاربری ادمین (اختیاری — پیش‌فرض: admin)
ADMIN_USERNAME=admin

# مسیر فایل دیتابیس (اختیاری — پیش‌فرض: diazland.db کنار پروژه)
DIAZLAND_DB=diazland.db
